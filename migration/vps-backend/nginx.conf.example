# Copy vào /etc/nginx/sites-available/api.ceoketnoitinhhoa.vn trên VPS, rồi:
#   sudo ln -s /etc/nginx/sites-available/api.ceoketnoitinhhoa.vn /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d api.ceoketnoitinhhoa.vn   ← tự thêm cấu hình SSL vào file này luôn,
#                                                         không cần tự sửa tay phần HTTPS.
server {
    listen 80;
    server_name api.ceoketnoitinhhoa.vn;

    client_max_body_size 200M;  # khớp giới hạn multer trong routes/upload.js

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
