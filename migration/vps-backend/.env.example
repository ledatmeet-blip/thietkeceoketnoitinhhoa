# Copy thành .env TRÊN VPS (không commit, không gõ giá trị vào chat với Claude).

# Postgres local trên VPS (không phải Supabase nữa) — tạo ở bước setup-vps.sh
DATABASE_URL=postgresql://ceo_app:MAT_KHAU_DB@localhost:5432/ceoketnoitinhhoa
PGSSL=disable

PORT=3000

# Admin login — PHẢI giữ NGUYÊN giá trị đang dùng trên Vercel hiện tại để không ai bị đăng xuất/
# mất quyền admin.
ADMIN_EMAIL=
ADMIN_PASS=

# SePay — giữ NGUYÊN giá trị đang dùng trên Vercel hiện tại.
SEPAY_WEBHOOK_KEY=

# Telegram bot — giữ NGUYÊN giá trị đang dùng trên Vercel hiện tại.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Gemini AI (chat bot + trợ lý website) — giữ NGUYÊN giá trị đang dùng.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# CORS — để * lúc mới chuyển cho an toàn, sau khi ổn định đổi thành domain thật:
ALLOWED_ORIGIN=*

# Nơi lưu file upload (ảnh/video/PDF) trên đĩa VPS, và base URL công khai để index.html load lại
UPLOAD_DIR=/var/www/ceoketnoitinhhoa-uploads
PUBLIC_UPLOAD_BASE_URL=https://api.ceoketnoitinhhoa.vn/uploads
