# Copy file này thành migration/.env rồi tự điền giá trị thật vào — KHÔNG gõ/dán
# các giá trị này vào khung chat với Claude. migration/.env đã được .gitignore
# (pattern ".env*" ở gốc repo) chặn không cho commit.
#
# Lấy 3 giá trị dưới đây ở Supabase Dashboard (supabase.com/dashboard → chọn project):
#   SUPABASE_DATABASE_URL → Project Settings → Database → Connection string → chọn
#                            "Transaction pooler" hoặc "Session pooler", copy nguyên dòng
#                            (nhớ thay [YOUR-PASSWORD] bằng mật khẩu DB thật)
#   SUPABASE_URL           → Project Settings → API → Project URL
#   SUPABASE_SERVICE_ROLE_KEY → Project Settings → API → service_role key (bí mật, KHÔNG
#                            phải anon key)

SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ceo-site
